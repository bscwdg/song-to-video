{
  "name": "painted-animation-template",
  "version": "0.1.0",
  "private": true,
  "description": "A runnable Remotion starter for the painted watercolor-and-ink style.",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts PaintedFilm out/painted-demo.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p",
    "still": "remotion still src/index.ts PaintedFilm out/poster.png --frame=45",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.9.3"
  }
}
