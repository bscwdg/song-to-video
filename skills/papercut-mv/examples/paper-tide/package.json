{
  "name": "paper-tide-example",
  "version": "1.0.0",
  "private": true,
  "description": "Paper Tide, a 24.056 second nine-shot layered paper-cut music video example.",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts PaperCutMV out/papercut-mv.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p",
    "still": "remotion still src/index.ts PaperCutMV out/poster.png --frame=102",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.9.3"
  }
}
