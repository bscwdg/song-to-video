{
  "name": "v2-engine",
  "version": "0.2.0",
  "private": true,
  "description": "Parameterized paper-cut MV engine: song facts -> shot list -> Remotion.",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "song": "python scripts/make_test_song.py",
    "still": "remotion still src/index.ts V2Song out/poster.png --frame=90",
    "render": "remotion render src/index.ts V2Song out/song.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p",
    "lab": "remotion still src/index.ts V2Lab out/lab.png --frame=75"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.9.3"
  }
}
